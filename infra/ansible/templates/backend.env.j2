SPRING_DATASOURCE_URL=jdbc:postgresql://{{ db_host }}:5432/{{ db_name }}
SPRING_DATASOURCE_USERNAME={{ db_user }}
SPRING_DATASOURCE_PASSWORD={{ hostvars['localhost'].db_password }}
CORS_ALLOWED_ORIGINS=https://{{ app_domain }}
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
# carrega o data.sql (usuários pedro@away.com e funcionario@away.com), como no seu ambiente local
SPRING_SQL_INIT_MODE=always
SPRING_JPA_HIBERNATE_DDL_AUTO=update
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM={{ keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ keycloak_client_id }}
KEYCLOAK_CLIENT_SECRET={{ keycloak_client_secret }}
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/realms/{{ keycloak_realm }}/protocol/openid-connect/certs
