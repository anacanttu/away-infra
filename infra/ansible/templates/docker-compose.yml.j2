services:
  nginx:
    image: nginx:1.27-alpine
    restart: unless-stopped
    ports:
      - "80:80"
    volumes:
      - {{ app_dir }}/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ app_dir }}/frontend:/usr/share/nginx/html:ro
    depends_on:
      - backend

  backend:
    image: eclipse-temurin:17-jre
    restart: unless-stopped
    working_dir: /app
    command: ["java", "-Xms128m", "-Xmx384m", "-jar", "/app/app.war"]
    env_file: {{ app_dir }}/backend/backend.env
    volumes:
      - {{ app_dir }}/backend/app.war:/app/app.war:ro
    depends_on:
      - keycloak

  # Só acessível dentro da rede do compose (não é exposto para a internet)
  keycloak:
    image: {{ keycloak_image }}
    restart: unless-stopped
    command: ["start-dev", "--import-realm"]
    environment:
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: "{{ keycloak_admin_password }}"
      KC_HEALTH_ENABLED: "true"
      JAVA_OPTS_KC_HEAP: "-Xms128m -Xmx512m"
    volumes:
      - {{ app_dir }}/keycloak/import:/opt/keycloak/data/import:ro
      - keycloak_data:/opt/keycloak/data/h2
    mem_limit: 900m

volumes:
  keycloak_data:
